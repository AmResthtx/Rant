# Texas Rigs & Roots Configuration

# Server
PORT=3000
NODE_ENV=development

# n8n Webhook (get this from your n8n workflow)
# Example: https://your-n8n-instance.com/webhook/texas-rigs-contact
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/contact

# Optional: Email service for notifications
SENDGRID_API_KEY=your_key_here
RECIPIENT_EMAIL=info@texasrigsroots.com
